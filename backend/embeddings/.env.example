# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_URL=https://openrouter.ai/api/v1/embeddings
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
PRICE_PER_1M_TOKENS=0.05

# SSH Configuration
SSH_USE=false
SSH_HOST=your_ssh_host
SSH_USER=your_ssh_user
SSH_PASSWORD=your_ssh_password

# Remote IPs
PG_REMOTE_IP=10.0.1.7
QDRANT_REMOTE_IP=10.0.3.2

# Local Ports
PG_LOCAL_PORT=5432
QDRANT_HTTP_PORT=6333

# PostgreSQL Configuration
PG_DB=postgres
PG_USER=postgres
PG_PASS=your_postgres_password

# Database Configuration (for ingest.py)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_SSLMODE=disable

# Qdrant Configuration
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key

# Pipeline Configuration
QRELS_FILE=data/dl23-qrels.txt
SOURCE_COLLECTION=small_openrouter_nc
TARGET_COLLECTION=qrels
BATCH_SIZE=200
MAX_TOKENS_PER_DOC=30000
MAX_QUEUE_SIZE=20
NUM_EMBED_WORKERS=15
QDRANT_UPSERT_BATCH_SIZE=300
