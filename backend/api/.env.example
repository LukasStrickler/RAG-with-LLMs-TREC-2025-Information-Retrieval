# API Authentication
# Required: API key for authentication (minimum 32 characters)
API_KEY=your-secret-api-key-minimum-32-characters-long

# API Server Configuration
# Optional: API host address (default: 0.0.0.0)
API_HOST=0.0.0.0

# Optional: API port (default: 8000)
API_PORT=8000

# Optional: CORS origins (comma-separated list, default: http://localhost:3000)
CORS_ORIGINS=["http://localhost:3000"]

# Data Configuration
# Optional: Path to qrels file (default: .data/trec_rag_assets/qrels.rag24.test-umbrela-all.txt)
# Can be absolute or relative to project root
QRELS_PATH=.data/trec_rag_assets/qrels.rag24.test-umbrela-all.txt

# SSH Tunnel Configuration
# Required for accessing remote services
SSH_HOST=your-ssh-host
SSH_USER=your-ssh-user
SSH_KEY_PATH=/path/to/your/private/key
# OR SSH_PASSWORD=your-password

# Remote Service Configuration
# Internal IPs of services on the remote network
REMOTE_DB_HOST=10.0.1.7
REMOTE_SOLR_HOST=10.0.1.X
REMOTE_QDRANT_HOST=10.0.1.Y

# Remote Ports (Optional, defaults shown)
# REMOTE_DB_PORT=5432
# REMOTE_SOLR_PORT=8983
# REMOTE_QDRANT_PORT=6333

# Database Credentials
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# Solr/Qdrant Configuration
SOLR_CORE=small
QDRANT_COLLECTION=documents
QDRANT_API_KEY=your-qdrant-api-key
